<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="666.0" prefWidth="300.0" spacing="10.0" style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-width: 0 0 0 1;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.kiz.KizPanelController">
    <children>
        <Label text="KIZ (ID:FROM-TO)">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <Label style="-fx-text-fill: #6c757d;" text="Nhập yêu cầu phân bổ KIZ cho đơn đang hiển thị" wrapText="true" />
        <TextArea fx:id="kizCommand" prefHeight="180.0" prefWidth="240.0" promptText="ID:FROM-TO">
            <font>
                <Font size="15.0" />
            </font>
        </TextArea>
        <Button mnemonicParsing="false" onAction="#onAddCategory" text="+ Thêm mặt hàng">
            <styleClass>
                <String fx:value="btn-sm" />
                <String fx:value="btn-primary" />
            </styleClass>
        </Button>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="376.0" prefWidth="250.0">
            <content>
                <VBox fx:id="categoryVBox" prefWidth="260.0" spacing="6.0" />
            </content>
        </ScrollPane>
    </children>
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
</VBox>
