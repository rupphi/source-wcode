<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox fx:id="root" alignment="CENTER_LEFT" minHeight="40.0" prefWidth="350.0" spacing="8.0" styleClass="card" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.kiz.CategoryItemController">
    <children>
        <Label fx:id="idLabel" prefWidth="56.0" text="ID: 0" styleClass="text-muted" />
        <Label fx:id="nameLabel" prefWidth="170.0" text="Category" styleClass="text-bold" />
        <TextField fx:id="countKizsField" alignment="CENTER" editable="false" prefWidth="72.0" text="0" />
        <Button fx:id="addKizBtn" mnemonicParsing="false">
            <styleClass>
                <String fx:value="btn-icon" />
            </styleClass>
            <graphic>
                <FontIcon iconLiteral="fth-upload" iconSize="14" iconColor="#5865F2"/>
            </graphic>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <Button fx:id="deleteCategoryBtn" mnemonicParsing="false">
            <styleClass>
                <String fx:value="btn-icon" />
            </styleClass>
            <graphic>
                <FontIcon iconLiteral="fth-trash-2" iconSize="14" iconColor="#da373c"/>
            </graphic>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
    </children>
    <padding>
        <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
    </padding>
</HBox>
