<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<HBox fx:id="root" alignment="CENTER_LEFT" minHeight="40.0" prefWidth="182.0" spacing="4.0" styleClass="bg-warning" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.kiz.CategoryItemController">
    <children>
        <Label fx:id="idLabel" prefWidth="46.0" text="ID: 0" />
        <Label fx:id="nameLabel" prefWidth="95.0" text="Category" />
        <TextField fx:id="countKizsField" alignment="CENTER" editable="false" prefWidth="46.0" text="0" />
        <Button fx:id="addKizBtn" mnemonicParsing="false" style="-fx-background-color: #0d6efd; -fx-text-fill: #e8e8e8; -fx-font-weight: bold;" text=" + ">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <Button fx:id="deleteCategoryBtn" mnemonicParsing="false" style="-fx-background-color: #d70202; -fx-text-fill: #e6e6e6;" text="Del" />
    </children>
    <padding>
        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
    </padding>
</HBox>
