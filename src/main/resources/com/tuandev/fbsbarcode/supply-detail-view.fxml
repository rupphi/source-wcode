<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="8.0" styleClass="card" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.supply.SupplyDetailController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Label fx:id="supplyTitleLabel" text="Chưa chọn supply" styleClass="h3" />
                <ProgressIndicator fx:id="orderLoading" maxHeight="20.0" maxWidth="20.0" prefHeight="20.0" prefWidth="20.0" visible="false" />
            </children>
        </HBox>
        <Label fx:id="supplyMetaLabel" managed="false" style="-fx-text-fill: #6c757d;" text="" visible="false" />
        <HBox fx:id="stickerLoadingBox" alignment="CENTER_LEFT" managed="false" spacing="8.0" visible="false">
            <children>
                <ProgressIndicator fx:id="stickerLoading" maxHeight="18.0" maxWidth="18.0" prefHeight="18.0" prefWidth="18.0" visible="false" />
                <Label fx:id="stickerLoadingLabel" style="-fx-text-fill: #6c757d;" text="Đang lấy mã vận đơn..." />
            </children>
        </HBox>
        <HBox fx:id="sortOptionsBox" alignment="CENTER_LEFT" managed="false" spacing="14.0" visible="false">
            <children>
                <CheckBox fx:id="sortBySubjectCheckBox" mnemonicParsing="false" selected="true" text="Danh mục" />
                <CheckBox fx:id="sortByArticleCheckBox" mnemonicParsing="false" selected="true" text="Article" />
                <CheckBox fx:id="sortByColorCheckBox" mnemonicParsing="false" selected="true" text="Màu" />
                <CheckBox fx:id="sortBySizeCheckBox" mnemonicParsing="false" selected="true" text="Size" />
            </children>
        </HBox>
        <Label fx:id="emptyStateLabel" managed="false" style="-fx-text-fill: #6c757d;" text="" visible="false" wrapText="true" />
        <TableView fx:id="orderTable" managed="false" prefHeight="520.0" prefWidth="900.0" visible="false">
            <columns>
                <TableColumn fx:id="noTC" prefWidth="54.0" text="No" />
                <TableColumn fx:id="idTC" prefWidth="85.0" text="№ задания" />
                <TableColumn fx:id="nameTC" prefWidth="180.0" text="Наименование" />
                <TableColumn fx:id="subjectNameTC" prefWidth="128.0" text="Категория" />
                <TableColumn fx:id="articleTC" prefWidth="128.0" text="Артикул продавца" />
                <TableColumn fx:id="colorTC" prefWidth="70.0" text="Цвет" />
                <TableColumn fx:id="sizeTC" prefWidth="74.0" text="Размер" />
                <TableColumn fx:id="stickerTC" prefWidth="90.0" text="Стикер" />
                <TableColumn fx:id="barcodeTC" prefWidth="95.0" text="Баркод" />
                <TableColumn fx:id="stickerCodeTC" prefWidth="100.0" text="Стикер Code" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
</VBox>
