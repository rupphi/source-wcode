<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.kizmapping.KizMappingController">
    <children>
        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
            <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="titleLabel" styleClass="h2" text="KIZ Mapping" />
                <ProgressIndicator fx:id="loadingIndicator" maxHeight="18.0" maxWidth="18.0" managed="false" prefHeight="18.0" prefWidth="18.0" progress="-1.0" visible="false" />
                <Label fx:id="loadingLabel" managed="false" styleClass="text-muted" text="Loading..." visible="false" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="8.0">
            <styleClass>
                <String fx:value="filter-bar" />
                <String fx:value="fbo-filter-bar" />
            </styleClass>
            <children>
                <TextField fx:id="searchField" prefWidth="300.0" promptText="Search nmId / name / vendor code" />
                <MenuButton fx:id="subjectMenuButton" mnemonicParsing="false" prefWidth="220.0" text="Subjects" />
                <Button fx:id="clearFiltersButton" managed="false" mnemonicParsing="false" onAction="#onClearFilters" visible="false">
                    <styleClass>
                        <String fx:value="button" />
                        <String fx:value="btn-icon" />
                        <String fx:value="fbo-clear-filter-button" />
                    </styleClass>
                    <graphic>
                        <FontIcon iconLiteral="fth-x" iconColor="#CCD1D9" iconSize="15" />
                    </graphic>
                </Button>
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="exportButton" mnemonicParsing="false" onAction="#onExport" prefHeight="32.0" text="Export">
                    <styleClass>
                        <String fx:value="button" />
                        <String fx:value="btn-success" />
                    </styleClass>
                    <graphic>
                        <FontIcon iconLiteral="fth-download" iconColor="white" iconSize="15" />
                    </graphic>
                </Button>
                <Button fx:id="importButton" mnemonicParsing="false" onAction="#onImport" prefHeight="32.0" text="Import">
                    <graphic>
                        <FontIcon iconLiteral="fth-upload" iconColor="white" iconSize="15" />
                    </graphic>
                </Button>
            </children>
        </HBox>
        <TableView fx:id="productTable" prefHeight="520.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="imageColumn" editable="false" prefWidth="72.0" sortable="false" text="Image" />
                <TableColumn fx:id="nameColumn" editable="false" prefWidth="170.0" sortable="false" text="Name" />
                <TableColumn fx:id="subjectColumn" editable="false" prefWidth="115.0" sortable="false" text="Subject" />
                <TableColumn fx:id="genderColumn" editable="false" prefWidth="110.0" sortable="false" text="Gender" />
                <TableColumn fx:id="vendorCodeColumn" editable="false" prefWidth="130.0" sortable="false" text="Vendor code" />
                <TableColumn fx:id="categoryIdColumn" prefWidth="82.0" sortable="false" text="KIZ ID" />
            </columns>
        </TableView>
        <Label fx:id="emptyStateLabel" managed="false" styleClass="text-muted" text="No products" visible="false" />
            </children>
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>
        </VBox>
        <VBox fx:id="kizPanelContainer" prefWidth="390.0" HBox.hgrow="NEVER" />
    </children>
</HBox>
