<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" styleClass="dialog-content" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.kiz.CategoryDialogController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <Label text="%category_dialog.id" />
        <TextField fx:id="idField" promptText="%category_dialog.id_prompt" />
        <Label text="%category_dialog.name" />
        <TextField fx:id="nameField" promptText="%category_dialog.name_prompt" />
    </children>
</VBox>
