<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefHeight="666.0" prefWidth="460.0" spacing="10.0" style="-fx-background-color: -bg-secondary; -fx-border-color: -border-color; -fx-border-width: 0 0 0 1px;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.kiz.KizPanelController">
    <children>
        <Label fx:id="kizTitleLabel" text="%kiz_panel.title" styleClass="h3" />
        <Button fx:id="addCategoryButton" mnemonicParsing="false" onAction="#onAddCategory" text="%kiz_panel.add_product">
            <styleClass>
                <String fx:value="button" />
                <String fx:value="btn-primary" />
            </styleClass>
            <graphic>
                <FontIcon iconLiteral="fth-plus" iconSize="14"/>
            </graphic>
        </Button>
        <HBox fx:id="loadingBox" alignment="CENTER_LEFT" managed="false" spacing="8.0" visible="false">
            <children>
                <ProgressIndicator fx:id="loadingIndicator" maxHeight="18.0" maxWidth="18.0" prefHeight="18.0" prefWidth="18.0" />
                <Label fx:id="loadingLabel" styleClass="text-muted" text="%kiz_panel.importing" />
            </children>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="categoryVBox" spacing="6.0" />
            </content>
        </ScrollPane>
    </children>
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
</VBox>
