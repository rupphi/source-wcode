<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox spacing="8" styleClass="znack-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.znack.ZnackAutomationController">
 <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
 <Label fx:id="titleLabel" styleClass="h2" text="%znack.title"/>
 <Label fx:id="authStatusLabel" styleClass="text-muted"/>
 <TabPane styleClass="packing-tabs" VBox.vgrow="ALWAYS">
  <tabs>
   <Tab fx:id="settingsTab" closable="false" text="%znack.tab.settings">
    <ScrollPane fitToWidth="true" styleClass="edge-to-edge">
     <VBox fx:id="basicSettingsCard" spacing="16" styleClass="card">
      <Label fx:id="settingsTitleLabel" styleClass="h3" text="%znack.settings.basic"/>
      <GridPane hgap="12" vgap="9">
       <Label fx:id="omsIdLabel" text="%znack.oms_id" GridPane.rowIndex="0"/>
       <TextField fx:id="omsIdField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
       <Button fx:id="omsIdHelpButton" accessibleText="%znack.help.oms_id.button" onAction="#showOmsIdHelp" styleClass="help-button" text="%common.help" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
       <Label fx:id="omsConnectionLabel" text="%znack.oms_connection" GridPane.rowIndex="1"/>
       <TextField fx:id="omsConnectionField" promptText="%znack.oms_connection_prompt" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
       <Button fx:id="omsConnectionHelpButton" accessibleText="%znack.help.oms_connection.button" onAction="#showOmsConnectionHelp" styleClass="help-button" text="%common.help" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
       <columnConstraints><ColumnConstraints minWidth="170"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints/></columnConstraints>
      </GridPane>
      <VBox fx:id="omsHelpPane" managed="false" spacing="8" styleClass="surface, help-pane" visible="false">
       <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="omsHelpTitleLabel" styleClass="h3" HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeOmsHelpButton" onAction="#closeOmsHelp" text="%common.close"/>
       </HBox>
       <Label fx:id="omsHelpDescriptionLabel" wrapText="true"/>
       <Label fx:id="omsHelpStepsTitleLabel" styleClass="text-strong" text="%znack.help.steps_title"/>
       <Label fx:id="omsHelpStepsLabel" styleClass="text-muted" wrapText="true"/>
       <Label fx:id="omsHelpRecognizeTitleLabel" styleClass="text-strong" text="%znack.help.recognize_title"/>
       <Label fx:id="omsHelpRecognizeLabel" styleClass="text-muted" wrapText="true"/>
       <Label fx:id="omsHelpWarningLabel" styleClass="help-warning" wrapText="true"/>
      </VBox>
      <VBox spacing="8" styleClass="surface">
       <Label fx:id="signatureTitleLabel" styleClass="h3" text="%znack.digital_signature"/>
       <Label fx:id="signatureHelpLabel" styleClass="text-muted" text="%znack.signature.help" wrapText="true"/>
       <ComboBox fx:id="signatureCertificateCombo" maxWidth="Infinity"/>
       <HBox spacing="8"><Button fx:id="testSignatureButton" onAction="#testSignature" styleClass="btn-primary" text="%znack.signature.test"/></HBox>
       <Label fx:id="signatureSummaryLabel" styleClass="text-muted"/>
      </VBox>
      <VBox spacing="9" styleClass="surface">
       <Label fx:id="defaultGoodsDocumentLabel" styleClass="h3" text="%znack.default_goods_document"/>
       <Label fx:id="defaultGoodsDocumentHelpLabel" styleClass="text-muted" text="%znack.default_goods_document_help" wrapText="true"/>
       <GridPane hgap="12" vgap="9">
        <Label fx:id="documentNumberLabel" text="%znack.document_number" GridPane.rowIndex="0"/><TextField fx:id="documentNumberField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label fx:id="documentIssueDateLabel" text="%znack.document_issue_date" GridPane.rowIndex="1"/><TextField fx:id="documentIssueDateField" promptText="%znack.date_prompt" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <columnConstraints><ColumnConstraints minWidth="170"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
       </GridPane>
       <CheckBox fx:id="autoIntroductionCheck" text="%znack.auto_introduction"/>
      </VBox>
      <HBox alignment="CENTER_RIGHT"><Button fx:id="saveButton" defaultButton="true" onAction="#save" styleClass="btn-primary" text="%znack.save"/></HBox>
     </VBox>
    </ScrollPane>
   </Tab>
    <Tab fx:id="productsTab" closable="false" text="%znack.tab.products">
        <VBox spacing="8">
            <padding><Insets top="8"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <TextField fx:id="productSearchField" promptText="%kiz_mapping.search_gtin" HBox.hgrow="ALWAYS"/>
                <Button fx:id="deleteSelectedButton" disable="true" onAction="#deleteSelectedProducts" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="fth-trash-2" iconSize="15"/></graphic>
                </Button>
            </HBox>
            <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="productSelectColumn" maxWidth="44" minWidth="44" prefWidth="44" resizable="false" sortable="false"/>
                    <TableColumn fx:id="productGtinColumn" prefWidth="150" />
                    <TableColumn fx:id="productNameColumn" prefWidth="400" />
                    <TableColumn fx:id="productTnVedColumn" prefWidth="150" />
                    <TableColumn fx:id="productActionsColumn" prefWidth="80" />
                </columns>
            </TableView>
        </VBox>
    </Tab>
    <Tab fx:id="deletedTab" closable="false" text="%znack.tab.deleted">
        <VBox spacing="8">
            <padding><Insets top="8"/></padding>
            <TextField fx:id="deletedSearchField" promptText="%kiz_mapping.search_gtin"/>
            <TableView fx:id="deletedTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="deletedGtinColumn" prefWidth="150" />
                    <TableColumn fx:id="deletedNameColumn" prefWidth="400" />
                    <TableColumn fx:id="deletedActionsColumn" prefWidth="110" />
                </columns>
            </TableView>
        </VBox>
    </Tab>
    <Tab fx:id="ordersTab" closable="false" text="%znack.tab.orders">
        <TableView fx:id="ordersTable">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="orderIdColumn" prefWidth="180" />
                <TableColumn fx:id="orderGtinColumn" prefWidth="180" />
                <TableColumn fx:id="orderStatusColumn" prefWidth="300" />
            </columns>
        </TableView>
    </Tab>
    <Tab fx:id="logsTab" closable="false" text="%znack.tab.logs">
        <TableView fx:id="logsTable">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="logTimeColumn" prefWidth="180" />
                <TableColumn fx:id="logActionColumn" prefWidth="150" />
                <TableColumn fx:id="logEntityColumn" prefWidth="150" />
                <TableColumn fx:id="logSeverityColumn" prefWidth="100" />
                <TableColumn fx:id="logResultColumn" prefWidth="300" />
            </columns>
        </TableView>
    </Tab>
  </tabs>
 </TabPane>
</VBox>
